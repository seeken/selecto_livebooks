# Selecto Output Formats and Execution Workbook

## Setup 1) Install Dependencies

Run this cell first. It installs the local `selecto_livebooks` project and its
current Selecto dependencies for this Livebook session.

```elixir
Code.require_file(Path.expand("support/bootstrap.exs", __DIR__))
SelectoLivebooksNotebookBootstrap.install!()
```

## Overview

This workbook focuses on execution-time output options and runtime metadata.

1. Standard execution (`execute/2`) with `rows/columns/aliases`
2. Rich metadata (`execute_with_metadata/2`)
3. Single-row contract (`execute_one/2`)
4. Built-in output formats (`:maps`, `:json`, `:csv`)
5. Advanced formats (`:typed_maps`, `:stream`)

```mermaid
flowchart LR
  query[Selecto query]
  exec[execute / execute_with_metadata / execute_one]
  format[format option]
  result[result payload]

  query --> exec --> result
  query --> format --> result
```

```mermaid
graph TD
  raw[raw tuple rows]
  maps[maps]
  json[json string]
  csv[csv text]
  stream[lazy stream]

  raw --> maps
  raw --> json
  raw --> csv
  raw --> stream
```

Before running, initialize the sample database:

```bash
mix setup
```

## Setup 2) Connect to Shared Repo and Load Domains

This cell starts the shared sample-app repo and loads the maintained product and
order domains from `selecto_livebooks`.

```elixir
config = SelectoLivebooks.NotebookSupport.config([:product_domain, :order_domain])
counts = SelectoLivebooks.NotebookSupport.table_counts(["products", "orders"])
product_count = counts["products"]
order_count = counts["orders"]

IO.puts("Connected. Products: #{product_count}, Orders: #{order_count}")

config
```

## Setup 3) Define Helper

This helper prints SQL and parameters once for each query.

```elixir
defmodule OutputLab.Helpers do
  @moduledoc false

  def explain(label, query), do: Selecto.Livebook.explain(label, query)
end
```

## Setup 4) Current Expression DSL Imports

This workbook focuses on execution behavior, but the example queries now use the
current expression DSL where it keeps the runtime/output examples concise.

```elixir
import Selecto.ExprMacros

:ok
```

## 1) Baseline `execute/2` (Raw Tuple Output)

`execute/2` returns `{:ok, {rows, columns, aliases}}` by default.

```elixir
import Selecto.ExprMacros

raw_query =
  Selecto.configure(config.product_domain, config.repo)
  |> Selecto.select(select([name, sku, price]))
  |> Selecto.filter(where(active == true))
  |> Selecto.order_by(order_by([asc(name)]))
  |> Selecto.limit(5)

OutputLab.Helpers.explain("Raw execute/2", raw_query)

case Selecto.execute(raw_query) do
  {:ok, {rows, columns, aliases}} ->
    IO.puts("Columns: #{inspect(columns)}")
    IO.puts("Aliases: #{inspect(aliases)}")
    IO.inspect(rows, label: "Rows")

  {:error, error} ->
    IO.puts("Error: #{inspect(error)}")
end
```

## 2) `execute_with_metadata/2`

Get result data plus metadata like SQL text, params, and execution time.

```elixir
import Selecto.ExprMacros

metadata_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select(select([order_number, status, total]))
  |> Selecto.filter(where(status == "delivered"))
  |> Selecto.order_by(order_by([desc(total)]))
  |> Selecto.limit(3)

OutputLab.Helpers.explain("execute_with_metadata/2", metadata_query)

case Selecto.execute_with_metadata(metadata_query) do
  {:ok, {rows, columns, _aliases}, metadata} ->
    IO.puts("Columns: #{inspect(columns)}")
    IO.inspect(rows, label: "Rows")
    IO.puts("Metadata keys: #{inspect(Map.keys(metadata))}")
    IO.puts("Execution time (ms): #{inspect(metadata[:execution_time])}")
    IO.puts("Metadata params: #{inspect(metadata[:params])}")
    IO.puts("Metadata SQL:\n#{metadata[:sql]}")

  {:error, error} ->
    IO.puts("Error: #{inspect(error)}")
end
```

## 3) `execute_one/2` Success and Guard Behavior

`execute_one/2` enforces exactly one row.

```elixir
import Selecto.ExprMacros

one_row_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select(select([order_number, status, total]))
  |> Selecto.filter(where(status == "delivered"))
  |> Selecto.order_by(order_by([desc(total)]))
  |> Selecto.limit(1)

many_rows_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select(select([order_number, status, total]))
  |> Selecto.filter(where(status == "delivered"))
  |> Selecto.limit(2)

OutputLab.Helpers.explain("execute_one/2 success case", one_row_query)

case Selecto.execute_one(one_row_query) do
  {:ok, {row, aliases}} ->
    IO.puts("Single row: #{inspect(row)}")
    IO.puts("Aliases: #{inspect(aliases)}")

  {:error, error} ->
    IO.puts("Unexpected error: #{inspect(error)}")
end

OutputLab.Helpers.explain("execute_one/2 guard case", many_rows_query)

case Selecto.execute_one(many_rows_query) do
  {:ok, {row, _aliases}} ->
    IO.puts("Unexpected single row: #{inspect(row)}")

  {:error, error} ->
    IO.puts("Expected guard error: #{inspect(error)}")
end
```

## 4) Built-in Output Formats (`:maps`, `:json`, `:csv`)

Switch `format` at execution time to get payloads ready for APIs or exports.

```elixir
import Selecto.ExprMacros

format_query =
  Selecto.configure(config.product_domain, config.repo)
  |> Selecto.select(select([name, sku, price]))
  |> Selecto.filter(where(active == true))
  |> Selecto.order_by(order_by([asc(name)]))
  |> Selecto.limit(5)

OutputLab.Helpers.explain("Formatted output query", format_query)

IO.puts("\nFormat :maps")
case Selecto.execute(format_query, format: :maps) do
  {:ok, maps} -> IO.inspect(maps, label: "maps")
  {:error, error} -> IO.puts("Error: #{inspect(error)}")
end

IO.puts("\nFormat {:json, [pretty: true]}")
case Selecto.execute(format_query, format: {:json, [pretty: true]}) do
  {:ok, json_string} -> IO.puts(json_string)
  {:error, error} -> IO.puts("Error: #{inspect(error)}")
end

IO.puts("\nFormat :csv")
case Selecto.execute(format_query, format: :csv) do
  {:ok, csv_string} -> IO.puts(csv_string)
  {:error, error} -> IO.puts("Error: #{inspect(error)}")
end
```

## 5) Advanced Formats (`:typed_maps`, `:stream`)

Use type-coerced maps and lazy streaming for larger processing pipelines.

```elixir
import Selecto.ExprMacros

advanced_format_query =
  Selecto.configure(config.product_domain, config.repo)
  |> Selecto.select(select([name, price, active]))
  |> Selecto.filter(where(active == true))
  |> Selecto.order_by(order_by([asc(name)]))
  |> Selecto.limit(10)

OutputLab.Helpers.explain("Advanced format query", advanced_format_query)

IO.puts("\nFormat {:typed_maps, [keys: :strings, coerce: :safe]}")
case Selecto.execute(advanced_format_query, format: {:typed_maps, [keys: :strings, coerce: :safe]}) do
  {:ok, typed_maps} ->
    typed_maps
    |> Enum.take(5)
    |> IO.inspect(label: "typed_maps preview")

  {:error, error} ->
    IO.puts("Error: #{inspect(error)}")
end

IO.puts("\nFormat {:stream, :maps}")
case Selecto.execute(advanced_format_query, format: {:stream, :maps}) do
  {:ok, row_stream} ->
    row_stream
    |> Enum.take(5)
    |> IO.inspect(label: "stream preview")

  {:error, error} ->
    IO.puts("Error: #{inspect(error)}")
end
```

## 6) `execute_stream/2` Contract Boundaries

`{:stream, ...}` format and `execute_stream/2` are related but not identical.

* `format: {:stream, :maps}` transforms a normal execute response into a lazy stream.
* `Selecto.execute_stream/2` asks the adapter/connection path to stream rows directly.

For adapter-backed paths, streaming requires an explicit contract:

* adapter must return `true` for `supports?(:stream)`
* adapter must implement `stream/4`
* connection input must match what the adapter's `stream/4` accepts

```elixir
import Selecto.ExprMacros

stream_query =
  Selecto.configure(config.product_domain, config.repo)
  |> Selecto.select(select([id, name]))
  |> Selecto.order_by(order_by([asc(id)]))
  |> Selecto.limit(5)

OutputLab.Helpers.explain("execute_stream/2 query", stream_query)

case Selecto.execute_stream(stream_query, analyze_complexity: false) do
  {:ok, row_stream} ->
    row_stream
    |> Enum.take(5)
    |> IO.inspect(label: "execute_stream preview")

  {:error, error} ->
    IO.puts("execute_stream error: #{inspect(error)}")
end

adapter_stream_probe =
  Selecto.configure(
    config.product_domain,
    SelectoLivebooks.NotebookSupport.repo_config(),
    adapter: SelectoDBPostgreSQL.Adapter
  )
  |> Selecto.select(select([id, name]))
  |> Selecto.order_by(order_by([asc(id)]))
  |> Selecto.limit(5)

case Selecto.execute_stream(adapter_stream_probe, analyze_complexity: false) do
  {:error, %Selecto.Error{details: details}} ->
    IO.inspect(details, label: "adapter stream contract details")

  other ->
    IO.inspect(other, label: "unexpected stream probe result")
end
```

