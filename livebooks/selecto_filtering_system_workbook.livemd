## Setup 3) Define Filter Helpers

This helper cell prints SQL/params and executes a query with a compact preview.

```elixir
defmodule FilteringLab.Helpers do
  @moduledoc false

  def explain(label, query), do: Selecto.Livebook.explain(label, query)

  def run(label, query, preview_count \\ 5) do
    Selecto.Livebook.run(label, query, preview_count: preview_count)
  end
end
```

## Setup 4) Current Expression DSL Imports

The first sections now use the shipped expression DSL (`Selecto.ExprMacros` and
`~SELECTO`) where it improves readability. Later cells still keep tuple forms
when they better expose lower-level filter shapes.

```elixir
import Selecto.ExprMacros
import Selecto.Sigil

alias Selecto.Expr, as: X

:ok
```

## 1) Equality and Comparison Filters

Use direct equality and numeric comparisons to narrow results quickly.

```elixir
import Selecto.ExprMacros

basic_filter_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select(select([order_number, status, total, shipping_country]))
  |> Selecto.filter(where(status == "delivered" and total > 100))
  |> Selecto.order_by(order_by([desc(total)]))
  |> Selecto.limit(10)

FilteringLab.Helpers.run("Equality + comparison", basic_filter_query)
```

## 2) Membership and Range Filters

Use `:in`, `:not_in`, and `:between` for set-based and bounded filtering.

```elixir
import Selecto.ExprMacros

alias Selecto.Expr, as: X

statuses = ["processing", "shipped", "delivered"]

membership_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select(select([id, order_number, status, total]))
  |> Selecto.filter(X.in("status", statuses))
  |> Selecto.filter(where(id >= 1 and id <= 50))
  |> Selecto.order_by(order_by([asc(id)]))
  |> Selecto.limit(10)

FilteringLab.Helpers.run("Membership + range", membership_query)

not_in_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select(select([order_number, status, total]))
  |> Selecto.filter(where(not_in(status, ["cancelled", "returned"])))
  |> Selecto.order_by(order_by([desc(inserted_at)]))
  |> Selecto.limit(10)

FilteringLab.Helpers.run("Not-in filter", not_in_query)
```

## 3) String Filters (`:like`, `:ilike`)

Pattern matching works across source and joined fields.

```elixir
import Selecto.ExprMacros
import Selecto.Sigil

name_pattern = "%a%"
country_pattern = "%U%"

string_filter_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select(select([order_number, customer.name, shipping_country]))
  |> Selecto.filter(~SELECTO"ilike(customer.name, ^name_pattern) or like(shipping_country, ^country_pattern)")
  |> Selecto.order_by(order_by([desc(inserted_at)]))
  |> Selecto.limit(10)

FilteringLab.Helpers.run("String pattern filters", string_filter_query)
```

## 4) Null and Not-Null Filters

Use `nil` for `IS NULL` and `:not_null` for `IS NOT NULL`.

```elixir
import Selecto.ExprMacros

null_filter_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select(select([order_number, status, shipped_at, delivered_at]))
  |> Selecto.filter(where(not is_nil(shipped_at) and is_nil(delivered_at)))
  |> Selecto.order_by(order_by([desc(inserted_at)]))
  |> Selecto.limit(10)

FilteringLab.Helpers.run("Null checks", null_filter_query)
```

## 5) Nested Logical Composition (`:and`, `:or`, `:not`)

Build expressive boolean logic trees with nested operators.

```elixir
import Selecto.ExprMacros

logical_filter_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select(select([order_number, status, total, customer.tier, shipping_country]))
  |> Selecto.filter(
    where(total >= 50 and (status == "processing" or status == "shipped") and shipping_country != "Antarctica")
  )
  |> Selecto.order_by(order_by([desc(total)]))
  |> Selecto.limit(10)

FilteringLab.Helpers.run("Nested logical filters", logical_filter_query)
```

## 6) Join-Aware Filters

Filter on joined table fields without manually writing JOIN clauses.

```elixir
import Selecto.ExprMacros

alias Selecto.Expr, as: X

join_filter_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select(select([order_number, customer.name, customer.tier, order_items.quantity, order_items.line_total]))
  |> Selecto.filter(X.in("customer.tier", ["gold", "platinum", "premium"]))
  |> Selecto.filter(where(order_items.quantity > 1))
  |> Selecto.order_by(order_by([desc(inserted_at)]))
  |> Selecto.limit(10)

FilteringLab.Helpers.run("Join-aware filters", join_filter_query)
```

## 7) Composable Filters Across Multiple `filter/2` Calls

`filter/2` is composable. Build a base query, then layer constraints incrementally.

```elixir
import Selecto.ExprMacros

alias Selecto.Expr, as: X

base_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select(select([order_number, status, total, shipping_country]))
  |> Selecto.order_by(order_by([desc(inserted_at)]))
  |> Selecto.limit(10)

geo_filtered_query =
  base_query
  |> Selecto.filter(X.in("shipping_country", ["USA", "Canada", "UK"]))

status_filtered_query =
  geo_filtered_query
  |> Selecto.filter(where(not_in(status, ["cancelled"])))

composable_filter_query =
  status_filtered_query
  |> Selecto.filter(where(total >= 75))

IO.inspect(composable_filter_query.set.filtered, label: "Accumulated filters")

FilteringLab.Helpers.run("Composable multi-stage filters", composable_filter_query)
```

## 8) Subquery Filters

Use `{:subquery, :in, query}` with a composed Selecto subquery.

```elixir
customer_subquery_domain = %{
  name: "Customers",
  source: config.order_domain.schemas.customers |> Map.put_new(:associations, %{}),
  schemas: %{},
  joins: %{}
}

eligible_customers_subquery =
  Selecto.configure(customer_subquery_domain, config.repo)
  |> Selecto.select(["id"])
  |> Selecto.filter({"tier", {:in, ["gold", "platinum"]}})

subquery_filter_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select(["order_number", "status", "total", "customer.name", "customer.tier"])
  |> Selecto.filter({"customer_id", {:subquery, :in, eligible_customers_subquery}})
  |> Selecto.order_by({"total", :desc})
  |> Selecto.limit(10)

FilteringLab.Helpers.run("Subquery filter", subquery_filter_query)
```

## 9) JSON and Array-Specific Filters

This section adds a product-focused domain so you can combine `json_filter/2` and `array_filter/2` in one query.

```elixir
product_filter_domain = %{
  name: "Products",
  source: %{
    source_table: "products",
    primary_key: :id,
    fields: [:id, :name, :price, :stock_quantity, :reorder_level, :active, :tags, :metadata],
    columns: %{
      id: %{type: :integer},
      name: %{type: :string},
      price: %{type: :decimal},
      stock_quantity: %{type: :integer},
      reorder_level: %{type: :integer},
      active: %{type: :boolean},
      tags: %{type: {:array, :string}},
      metadata: %{type: :jsonb}
    },
    associations: %{}
  },
  schemas: %{},
  joins: %{}
}

metadata_refresh =
  config.repo.query!("""
  UPDATE products
  SET metadata = jsonb_build_object(
    'price_band',
    CASE
      WHEN price >= 100 THEN 'premium'
      WHEN price >= 50 THEN 'mid'
      ELSE 'budget'
    END,
    'warehouse',
    jsonb_build_object(
      'zone',
      CASE WHEN stock_quantity <= reorder_level THEN 'restock' ELSE 'in_stock' END
    ),
    'flags',
    jsonb_build_array(
      CASE WHEN active THEN 'active' ELSE 'inactive' END,
      CASE WHEN coalesce(array_length(tags, 1), 0) > 0 THEN 'has_tags' ELSE 'untagged' END
    )
  )
  """)

IO.puts("Product metadata refreshed for filter demo: #{metadata_refresh.num_rows}")

json_array_filter_query =
  Selecto.configure(product_filter_domain, config.repo)
  |> Selecto.select(["name", "price", "tags", "active"])
  |> Selecto.json_select([
    {:json_extract_text, "metadata", "$.price_band", as: "price_band"},
    {:json_extract_text, "metadata", "$.warehouse.zone", as: "warehouse_zone"}
  ])
  |> Selecto.json_filter([
    {:json_extract_text, "metadata", "$.warehouse.zone", {:=, "in_stock"}},
    {:json_path_exists, "metadata", "$.flags[0]"}
  ])
  |> Selecto.array_filter({:array_overlap, "tags", ["featured", "new", "promo"]})
  |> Selecto.order_by({"price", :desc})
  |> Selecto.limit(10)

FilteringLab.Helpers.run("JSON + array filters", json_array_filter_query)
```

## 10) Pre- vs Post-Retarget Filters

Compare pre-retarget and post-retarget filtering behavior and inspect the resulting SQL.
For the current Selecto build, post-retarget filters should target the retarget root field name directly (for example `"quantity"`), so this example uses `Selecto.post_retarget_filter/2`.

```elixir
import Selecto.ExprMacros

retarget_pre_filter_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.filter(where(status == "delivered"))
  |> Selecto.retarget(:order_items, subquery_strategy: :exists)
  |> Selecto.select(select([order_items.product_id, order_items.quantity, order_items.line_total]))
  |> Selecto.limit(10)

retarget_pre_and_post_filter_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.filter(where(status == "delivered"))
  |> Selecto.retarget(:order_items, subquery_strategy: :exists)
  |> Selecto.post_retarget_filter({"quantity", 2})
  |> Selecto.select(select([order_items.product_id, order_items.quantity, order_items.line_total]))
  |> Selecto.limit(10)

retarget_post_only_query =
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.filter(where(status == "delivered"))
  |> Selecto.retarget(:order_items, subquery_strategy: :exists, preserve_filters: false)
  |> Selecto.post_retarget_filter({"quantity", 2})
  |> Selecto.select(select([order_items.product_id, order_items.quantity, order_items.line_total]))
  |> Selecto.limit(10)

for {label, query} <- [
      {"Pre-retarget filter only", retarget_pre_filter_query},
      {"Pre + post retarget filters", retarget_pre_and_post_filter_query},
      {"Post-retarget only (preserve_filters: false)", retarget_post_only_query}
    ] do
  {sql, _params} = Selecto.to_sql(query)
  sql_downcase = String.downcase(sql)

  IO.puts("\n#{label}")
  IO.puts("Contains status predicate? #{String.contains?(sql_downcase, "status")}")
  IO.puts("Contains quantity predicate? #{String.contains?(sql_downcase, "quantity")}")

  FilteringLab.Helpers.run(label, query, 5)
end

:ok
```

## 11) Filter Challenge: Build and Verify SQL

Edit the challenge builder to meet the goal, then use SQL fragment checks to confirm the query includes each required condition.

```elixir
import Selecto.ExprMacros

challenge_goal = """
Return delivered or shipped orders to USA/Canada with total >= 120,
sorted by total descending.
"""

IO.puts("Challenge goal: " <> String.trim(challenge_goal))

challenge_query_builder = fn ->
  Selecto.configure(config.order_domain, config.repo)
  |> Selecto.select(select([order_number, status, shipping_country, total]))
  |> Selecto.filter(
    where(
      (status == "delivered" or status == "shipped") and
        (shipping_country == "USA" or shipping_country == "Canada") and total >= 120
    )
  )
  |> Selecto.order_by(order_by([desc(total)]))
  |> Selecto.limit(10)
end

challenge_query = challenge_query_builder.()
{challenge_sql, _challenge_params} = Selecto.to_sql(challenge_query)
challenge_sql_downcase = String.downcase(challenge_sql)

required_fragments = ["status", "shipping_country", "total", "order by", "limit"]

fragment_checks =
  Enum.map(required_fragments, fn fragment ->
    {fragment, String.contains?(challenge_sql_downcase, fragment)}
  end)

IO.inspect(fragment_checks, label: "SQL fragment checks")
IO.puts("All checks pass? #{Enum.all?(fragment_checks, fn {_f, ok?} -> ok? end)}")

FilteringLab.Helpers.run("Challenge query", challenge_query, 10)
```

